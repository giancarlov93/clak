{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clak",
  "mainBinaryName": "ClakApp",
  "identifier": "dev.clak.Clak",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "Clak",
    "copyright": "Copyright © 2026 Giancarlo Viali",
    "category": "DeveloperTool",
    "shortDescription": "Lets AI agents use the programs open on your computer, with your consent",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFQjBGNUE3RjMyQjdEQzQKUldURWZTdnpwL1d3UG5mTy91TFRhZXpkazRrc09VZU5XVk4wTEszYlhacTlaTld2T2ZJaWxwN1UK",
      "endpoints": [
        "https://github.com/giancarlov93/clak/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
